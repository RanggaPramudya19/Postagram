<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Create Post | Postagram</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<style>

body{

    background:#000;
    color:white;
    font-family:Arial, Helvetica, sans-serif;

}

.container{

    max-width:760px;
    margin:50px auto;

}

.topbar{

    display:flex;
    justify-content:space-between;
    align-items:center;

    margin-bottom:25px;

}

.logo{

    font-size:40px;
    font-weight:bold;

}

.back{

    border-radius:50px;

}

.compose{

    background:#111;
    border:1px solid #2c2c2c;
    border-radius:25px;
    overflow:hidden;

}

.compose-header{

    display:flex;
    align-items:center;

    padding:30px;

}

.avatar{

    width:60px;
    height:60px;
    border-radius:50%;
    object-fit:cover;
    margin-right:18px;

}

.name{

    font-size:20px;
    font-weight:bold;

}

.username{

    color:#888;

}

textarea{

    background:transparent !important;
    border:none !important;
    color:white !important;
    font-size:22px;
    resize:none;
    min-height:220px;

}

textarea:focus{

    box-shadow:none;

}

.upload-box{
    margin:20px 30px;
    border:2px dashed #444;
    border-radius:20px;
    min-height:220px;
    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    cursor:pointer;
    overflow:hidden;
    transition:.3s;
    background:#181818;
}

.upload-box:hover{
    border-color:#fff;
    background:#202020;
}

.upload-box i{

    font-size:50px;

}

.preview{
    width:100%;
    height:100%;
    object-fit:cover;
    border-radius:18px;
    display:none;
}

.footer{

    padding:25px 30px;

    border-top:1px solid #2c2c2c;

    display:flex;
    justify-content:space-between;
    align-items:center;

}

.footer span{

    color:#8a8a8a;

}

.btn-post{

    border-radius:50px;
    padding:10px 30px;
    font-weight:bold;

}

input[type=file]{

    display:none;

}

</style>

</head>

<body>

<div class="container">

<div class="topbar">

<div class="logo">

Postagram

</div>

<a href="/" class="btn btn-outline-light back">

<i class="bi bi-arrow-left"></i>

Back

</a>

</div>

<div class="compose">

<form
action="/post/add"
method="POST"
enctype="multipart/form-data">

<div class="compose-header">

<div>

<div class="name">

Create New Post

</div>

<div class="username">

Share something with everyone

</div>

</div>

</div>

<div class="px-4">

<textarea
class="form-control"
name="description"
placeholder="What's happening?"
required></textarea>

</div>

<label class="upload-box">

    <i id="uploadIcon" class="bi bi-images"></i>

    <h5 id="uploadTitle" class="mt-3">
        Add Photo
    </h5>

    <small id="uploadText" class="text-secondary">
        Upload Photo
    </small>

    <img
        id="preview"
        class="preview">

    <input
        type="file"
        name="image"
        accept="image/*"
        onchange="previewImage(event)">

</label>
</label>


<div class="mb-4 text-center">

    <label class="form-label text-light fw-semibold fs-5 mb-3 d-block">

        <i class="bi bi-tags-fill me-2"></i>    

        Choose Category

    </label>

    <div class="d-flex flex-wrap justify-content-center gap-2">

        <% categories.forEach(category => { %>

            <input
                type="checkbox"
                class="btn-check"
                name="CategoryId[]"
                id="category<%= category.id %>"
                value="<%= category.id %>"
                autocomplete="off">

            <label
                class="btn btn-outline-light btn-sm rounded-pill px-3 py-1"
                for="category<%= category.id %>">

                <%= category.name %>

            </label>

        <% }) %>

    </div>

</div>

</div>

</div>





<div class="footer">

<button
class="btn btn-light btn-post">

<i class="bi bi-send-fill"></i>

Share

</button>

</div>

</form>

</div>

</div>

<script>

function previewImage(event){

    const file = event.target.files[0];

    if(!file) return;

    const preview = document.getElementById("preview");

    preview.src = URL.createObjectURL(file);
    preview.style.display = "block";

    document.getElementById("uploadIcon").style.display = "none";
    document.getElementById("uploadTitle").style.display = "none";
    document.getElementById("uploadText").style.display = "none";
}

</script>

</body>

</html>