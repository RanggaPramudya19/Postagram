<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account | Postagram</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            font-family: Inter, Arial, Helvetica, sans-serif;
        }

        body {
            background: #000;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .register-card {
            width: 850px;
            background: #181818;
            border: 1px solid #2f2f2f;
            border-radius: 24px;
            padding: 40px;
        }

        .logo {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: white;
            color: black;
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
        }

        h1 {
            color: white;
            font-weight: 700;
        }

        p {
            color: #9d9d9d;
        }

        label {
            color: #d7d7d7;
            margin-bottom: 6px;
        }

        .form-control {
            background: #252525;
            border: 1px solid transparent;
            color: white;
            border-radius: 14px;
            padding: 12px;
        }

        .form-control::placeholder {
            color: #888;
        }

        .form-control:focus {
            background: #252525;
            color: white;
            border: 1px solid white;
            box-shadow: none;
        }

        textarea.form-control {
            resize: none;
        }

        .btn-register {
            background: white;
            color: black;
            border-radius: 14px;
            padding: 12px;
            font-weight: 600;
            transition: .2s;
        }

        .btn-register:hover {
            background: #d9d9d9;
        }

        a {
            color: white;
            text-decoration: none;
            font-weight: 600;
        }

        a:hover {
            text-decoration: underline;
        }

        hr {
            border-color: #333;
        }
    </style>

</head>

<body>

    <div class="register-card shadow-lg">

        <div class="logo mb-4">
            P
        </div>

        <h1 class="text-center">
            Join Postagram
        </h1>

        <p class="text-center mb-5">
            Create your account and start sharing.
        </p>

        <form action="/register" method="POST" enctype="multipart/form-data">

    <div class="row">

        <div class="col-md-6 mb-3">
            <label>Full Name</label>
            <input
                type="text"
                name="fullName"
                class="form-control"
                placeholder="Name"
                required>
        </div>

        <div class="col-md-6 mb-3">
            <label>Email</label>
            <input
                type="email"
                name="email"
                class="form-control"
                placeholder="Email"
                required>
        </div>

        <div class="col-md-6 mb-3">
            <label>Password</label>
            <input
                type="password"
                name="password"
                class="form-control"
                placeholder="Password"
                required>
        </div>

        <div class="col-md-6 mb-3">
            <label>Profile Picture</label>
            <input
                type="file"
                name="profilePicture"
                class="form-control"
                accept="image/*">
        </div>

        <div class="col-12 mb-3">
            <label>Bio</label>
            <textarea
                name="bio"
                rows="3"
                class="form-control"
                placeholder="Add Bio"></textarea>
        </div>

        <div class="col-12 mb-3">
            <label>Social Media Link</label>
            <input
                type="text"
                name="linkSocmed"
                class="form-control"
                placeholder="Link">
        </div>

        <div class="col-md-6 mb-4">
            <label>Gender</label>

            <select
                name="gender"
                class="form-control"
                required>

                <option value="" disabled selected>
                    -- Select Gender --
                </option>

                <option value="Male">
                    Male
                </option>

                <option value="Female">
                    Female
                </option>

            </select>
        </div>

    </div>

    <button class="btn btn-register w-100">
        Create Account
    </button>

</form>

<hr class="my-4">

<p class="text-center mb-0">
    Already have an account?
    <a href="/login">Login</a>
</p>

<hr class="my-4">

<p class="text-center mb-0">
    Back to
    <a href="/">Home</a>
</p>

</body>

</html>