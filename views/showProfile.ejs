<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Profile</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<style>

body{
    background:#000;
    color:white;
}

.container{
    max-width:850px;
    margin:40px auto;
}

.profile-card{
    background:#111;
    border:1px solid #2b2b2b;
    border-radius:20px;
    padding:30px;
    text-align:center;
}

.avatar{
    width:120px;
    height:120px;
    border-radius:50%;
    object-fit:cover;
}

.post{
    background:#111;
    border:1px solid #2b2b2b;
    border-radius:18px;
    padding:20px;
    margin-top:20px;
}

.post img{
    width:100%;
    border-radius:12px;
    margin-top:15px;
}

</style>

</head>

<body>
   <% if (success) { %>
    <div class="container">
    <div class="alert alert-danger" role="alert">
      <%= success %>
    </div>
    
    </div>
    
   <% } %> 
   <div class="container">

<div class="d-flex justify-content-between mb-4">

<a href="/" class="btn btn-outline-light rounded-pill">

<i class="bi bi-arrow-left"></i>

Back Home

</a>


</div>

<div class="profile-card">

<% if(user.UserProfile && user.UserProfile.profilePicture){ %>

<img src="<%= user.UserProfile.profilePicture %>" class="avatar">

<% } else { %>

<img src="https://ui-avatars.com/api/?name=<%= user.email %>" class="avatar">

<% } %>

<h3 class="mt-3">

<%= user.UserProfile.fullName %>

</h3>

<p class="text-secondary">

@<%= user.email.split("@")[0] %>

</p>

<p>

<%= user.UserProfile.bio %>

</p>

<p>

<a href="<%= user.UserProfile.linkSocmed %>" class="text-info">

<%= user.UserProfile.linkSocmed %>

</a>

</p>

<p>

<b><%= user.Posts.length %></b> Posts

</p>

</div>

<h3 class="mt-5">

    My Posts

</h3>

<% user.Posts.forEach(post=>{ %>

<div class="post">

    <div class="d-flex justify-content-between align-items-center">

        <h5>

            <%= user.UserProfile.fullName %>

        </h5>

        <% if(currentUserId === user.id){ %>

        <div class="d-flex gap-2">

            <a
                href="/post/<%= post.id %>/edit"
                class="btn btn-sm btn-outline-warning">

                <i class="bi bi-pencil-square"></i>

            </a>

            <a
                href="/post/<%= post.id %>/delete"
                class="btn btn-sm btn-outline-danger"
                onclick="return confirm('Delete this post?')">

                <i class="bi bi-trash"></i>

            </a>

        </div>

        <% } %>

    </div>

    <p class="mt-3">

        <%= post.description %>

    </p>

    <% if(post.imageUrl){ %>

        <img src="<%= post.imageUrl %>">

    <% } %>
            <%= getTimeAgo(post.createdAt) %>
</div>

<% }) %>

</div>
</div>

</body>
</html>