<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Postagram</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <style>
        body {
            background: #000;
            color: white;
            font-family: Arial, Helvetica, sans-serif;
        }

        .sidebar {
            width: 230px;
            position: fixed;
            height: 100vh;
            padding: 30px;
            border-right: 1px solid #222;
        }

        .sidebar h3 {
            font-weight: bold;
            margin-bottom: 40px;
        }

        .sidebar a {
            display: block;
            color: white;
            text-decoration: none;
            padding: 12px 0;
            font-size: 18px;
        }

        .sidebar a:hover {
            color: #0dcaf0;
        }

        .feed {
            width: 650px;
            margin: auto;
            padding: 30px;
        }

        .post {
            background: #111;
            border: 1px solid #262626;
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .avatar {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
        }

        .post-image {
            width: 100%;
            border-radius: 15px;
            margin-top: 15px;
        }

        .icon-group i {
            font-size: 20px;
            margin-right: 20px;
            cursor: pointer;
        }

        .icon-group i:hover {
            color: #0dcaf0;
        }

        .rightbar {
            width: 280px;
            position: fixed;
            right: 0;
            top: 0;
            height: 100vh;
            padding: 30px;
            border-left: 1px solid #222;
        }

        .badge {
            margin-right: 5px;
        }

        .delete-btn {

            border-radius: 50%;
            width: 38px;
            height: 38px;
            display: flex;
            justify-content: center;
            align-items: center;
            transition: .2s;

        }

        .delete-btn:hover {

            transform: scale(1.08);

        }
    </style>

</head>

<body>

    <!-- Sidebar -->

    <div class="sidebar">

        <h2 class="fw-bold mb-5">
            Postagram
        </h2>

        <a href="/">
            <i class="bi bi-house-door-fill"></i>
            Home
        </a>

        <form action="/" method="GET" class="mt-3 mb-3">

            <div class="input-group">

                <span class="input-group-text bg-dark text-white border-secondary">
                    <i class="bi bi-search"></i>
                </span>

                <input type="text" name="search" class="form-control bg-dark text-white border-secondary"
                    placeholder="Search caption..." value="<%= search || '' %>">

            </div>

        </form>

        <% if(currentUser){ %>

            <a href="/post/add">
                <i class="bi bi-plus-square"></i>
                Create Post
            </a>

            <a href="/profile">
                <i class="bi bi-person-circle"></i>
                My Profile
            </a>

            <a href="/logout">
                <i class="bi bi-box-arrow-right"></i>
                Logout
            </a>

            <% } else { %>

                <a href="/login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    Login
                </a>

                <a href="/register">
                    <i class="bi bi-person-plus"></i>
                    Register
                </a>

                <% } %>

    </div>

    <!-- Feed -->

    <div class="feed">

        <% posts.forEach(post=>{ %>

            <div class="post">

                <div class="d-flex align-items-center">

                    <% if(post.User.UserProfile && post.User.UserProfile.profilePicture){ %>

                        <img src="<%= post.User.UserProfile.profilePicture %>" class="avatar">

                        <% }else{ %>

                            <img src="https://ui-avatars.com/api/?name=<%= post.User.email %>&background=random"
                                class="avatar">

                            <% } %>

                                <div class="ms-3">

                                    <b>

                                        <%= post.User.UserProfile ? post.User.UserProfile.bioFullname : post.User.email
                                            %>

                                    </b>

                                    <br>

                                   

                                </div>

                </div>

                <p class="mt-3">

                    <%= post.description %>

                </p>

                <% if(post.imageUrl){ %>

                    <img src="<%= post.imageUrl %>" class="post-image">

                    <% } %>

                        <div class="mt-3">

                            <% post.Categories.forEach(category=>{ %>

                                <span class="badge bg-secondary">

                                    <%= category.name %>

                                </span>

                                <% }) %>

                        </div>

                        <%= getTimeAgo(post.createdAt) %>
            </div>

            <% }) %>

    </div>

    <!-- Right -->

    <!-- Right Sidebar -->

    <div class="rightbar">

        <div class="rightbar">

    <% if(currentUser){ %>

        <!-- Profile Card -->
        <div class="card bg-dark border-secondary rounded-4 shadow-lg">

            <div class="card-body text-center">

                <% if(currentUser.UserProfile && currentUser.UserProfile.profilePicture){ %>

                    <img
                        src="<%= currentUser.UserProfile.profilePicture %>"
                        class="rounded-circle mb-3"
                        width="90"
                        height="90"
                        style="object-fit:cover;">

                <% } else { %>

                    <img
                        src="https://ui-avatars.com/api/?name=<%= currentUser.email %>&background=random"
                        class="rounded-circle mb-3">

                <% } %>

                <h4 class="fw-bold">
                    <%= currentUser.UserProfile ? currentUser.UserProfile.fullName : currentUser.email %>
                </h4>

                <p class="text-secondary">
                    <%= currentUser.UserProfile.fullName %>
                </p>

                <hr>

            </div>

        </div>

    <% } else { %>

        <!-- Welcome Card -->
        <div class="card bg-dark border-secondary rounded-4 shadow-lg overflow-hidden">

            <div class="card-body p-4 text-center">

                <div class="mb-4">
                    <div class="logo-circle mx-auto">
                        <i class="bi bi-camera-fill"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-white">
                    Welcome to
                    <br>
                    Postagram
                </h2>

                <p class="text-secondary mt-3">
                    Share your best moments, discover inspiring stories,
                    and connect with people around the world.
                </p>

            </div>

        </div>

    <% } %>

    <!-- Categories Card (SELALU MUNCUL) -->
    <div class="card bg-dark border-secondary rounded-4 shadow-lg mt-3">

        <div class="card-body">

            <h6 class="fw-bold mb-3">
                Browse Categories
            </h6>

            <a
                href="/"
                class="btn btn-outline-light btn-sm rounded-pill mb-2">

                All Posts

            </a>

            <% categories.forEach(item => { %>

                <a
                    href="/?category=<%= item.id %>"
                    class="btn btn-outline-secondary btn-sm rounded-pill mb-2">

                    <%= item.name %>

                </a>

            <% }) %>

        </div>

    </div>

</div>

</body>

</html>