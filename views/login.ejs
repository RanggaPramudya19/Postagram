<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Postagram</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            font-family: Inter, Arial, Helvetica, sans-serif;
        }

        body {
            background: #101010;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-card {
            width: 430px;
            background: #181818;
            border: 1px solid #2f2f2f;
            border-radius: 24px;
            padding: 40px;
        }

        .logo {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: white;
            color: black;
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 32px;
            font-weight: bold;
        }

        h1 {
            color: white;
            font-weight: 700;
        }

        p {
            color: #9b9b9b;
        }

        .form-control {
            background: #252525;
            border: 1px solid transparent;
            color: white;
            border-radius: 14px;
            padding: 14px;
        }

        .form-control::placeholder {
            color: #9f9f9f;
        }

        .form-control:focus {
            background: #252525;
            color: white;
            border: 1px solid white;
            box-shadow: none;
        }

        .btn-login {
            background: white;
            color: black;
            border-radius: 14px;
            padding: 13px;
            font-weight: 600;
            transition: .2s;
        }

        .btn-login:hover {
            background: #d9d9d9;
        }

        a {
            color: white;
            text-decoration: none;
            font-weight: 600;
        }

        a:hover {
            text-decoration: underline;
        }

        hr {
            border-color: #3a3a3a;
        }
    </style>

</head>

<body>

    <div class="login-card shadow-lg">

        <div class="logo mb-4">
            P
        </div>

        <h1 class="text-center mb-2">
            Welcome Back
        </h1>

        <p class="text-center mb-5">
            Login to continue to <strong>Postagram</strong>
        </p>

        <form action="/login" method="POST">

            <div class="mb-3">

                <input
                    type="email"
                    class="form-control"
                    name="email"
                    placeholder="Email"
                    required>

            </div>

            <div class="mb-4">

                <input
                    type="password"
                    class="form-control"
                    name="password"
                    placeholder="Password"
                    required>

            </div>

            <button class="btn btn-login w-100">

                Login

            </button>

        </form>

        <hr class="my-4">

        <p class="text-center mb-0">

            Don't have an account?

            <a href="/register">

                Create Account

            </a>

        </p>

        <hr class="my-4">

        <p class="text-center mb-0">

            Back to Home

            <a href="/">

                Home

            </a>

        </p>


    </div>

</body>

</html>